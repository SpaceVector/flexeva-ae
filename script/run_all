#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON_BIN:-$ROOT/.venv/bin/python}"

[[ $# == 0 ]] || { echo "usage: script/run_all" >&2; exit 2; }
[[ "${RUN_ALL_DRY_RUN:-0}" == 1 ]] || source "$ROOT/script/lib/ae_env.sh"
if [[ "$PYTHON_BIN" != */* ]]; then
    PYTHON_BIN="$(command -v "$PYTHON_BIN" || true)"
fi
[[ -n "$PYTHON_BIN" ]] || { echo "run_all: Python is unavailable" >&2; exit 2; }
PYTHON_BIN="$(cd -- "$(dirname -- "$PYTHON_BIN")" && pwd -P)/$(basename -- "$PYTHON_BIN")"
export PYTHON_BIN

export RUN_ALL_ID="${RUN_ALL_ID:-ae-$(date -u +%Y%m%d-%H%M%S)}"
export E1_RUN_ID="${E1_RUN_ID:-$RUN_ALL_ID-e1}"
export TABLE4_RUN_ID="${TABLE4_RUN_ID:-$RUN_ALL_ID-e2-table4}"
export FIGURE5_RUN_ID="${FIGURE5_RUN_ID:-$RUN_ALL_ID-e2-figure5}"
export FIGURE5_MODE="${FIGURE5_MODE:-trace}"
export FIGURE6_RUN_ID="${FIGURE6_RUN_ID:-$RUN_ALL_ID-e3-figure6}"
export FIGURE7_RUN_ID="${FIGURE7_RUN_ID:-$RUN_ALL_ID-e3-figure7}"
export FIGURE8_RUN_ID="${FIGURE8_RUN_ID:-$RUN_ALL_ID-e3-figure8}"
export E4_RUN_ID="${E4_RUN_ID:-$RUN_ALL_ID-e4}"
export E5_RUN_ID="${E5_RUN_ID:-$RUN_ALL_ID-e5}"
export FLEXMAYA_MASTER_PORT="${FLEXMAYA_MASTER_PORT:-29500}"
export FLEXMAYA_CONTROL_PORT="${FLEXMAYA_CONTROL_PORT:-29600}"

run() {
    echo "==> $1"
    shift
    if [[ "${RUN_ALL_DRY_RUN:-0}" == 1 ]]; then
        printf '    '
        printf '%q ' "$@"
        printf '\n'
    else
        "$@"
    fi
}

run "setup check" "$ROOT/script/check_setup"
run "E1" "$ROOT/script/run_e1"
run "E2" "$ROOT/script/run_e2"
run "E3" "$ROOT/script/run_e3"
run "E4" "$ROOT/script/run_e4"
run "E5" "$ROOT/script/run_e5"

if [[ "${RUN_ALL_DRY_RUN:-0}" == 1 ]]; then
    echo "AE reproduction plan: PASS ($RUN_ALL_ID)"
else
    echo "AE full reproduction: PASS ($RUN_ALL_ID)"
fi
