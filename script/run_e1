#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON_BIN:-$ROOT/.venv/bin/python}"
TRACE_ROOT="${E1_TRACE_ROOT:-$ROOT/large-cluster/e1/historical_sparse_moe}"
LEDGER="${E1_LEDGER:-$ROOT/large-cluster/e1/trajectory.csv}"
LEDGER_SHA256="4a5a967f765731540fd0bc5fa383dcc85e6ff79443b696361ae985e95375345d"
RUN_ID="${E1_RUN_ID:-${RUN_ALL_ID:-e1-$(date -u +%Y%m%d-%H%M%S)}}"
RESULT_ROOT="${E1_RESULT_ROOT:-$ROOT/result/e1/generated/$RUN_ID}"
MODE="${1:-trace}"

[[ $# -le 1 && "$MODE" == trace ]] || { echo "usage: script/run_e1 [trace]" >&2; exit 2; }
if [[ "$PYTHON_BIN" != */* ]]; then
    PYTHON_BIN="$(command -v "$PYTHON_BIN" || true)"
fi
[[ -n "$PYTHON_BIN" ]] || { echo "run_e1: Python is unavailable" >&2; exit 2; }
PYTHON_BIN="$(cd -- "$(dirname -- "$PYTHON_BIN")" && pwd -P)/$(basename -- "$PYTHON_BIN")"
test -f "$LEDGER" || { echo "run_e1: missing historical ledger: $LEDGER" >&2; exit 2; }
read -r ledger_sha256 _ < <(sha256sum "$LEDGER")
[[ "$ledger_sha256" == "$LEDGER_SHA256" ]] || { echo "run_e1: historical ledger checksum differs" >&2; exit 2; }
[[ ! -e "$RESULT_ROOT" ]] || {
    echo "run_e1: output already exists; use a new E1_RUN_ID" >&2
    exit 2
}

mkdir -p "$RESULT_ROOT"
"$PYTHON_BIN" "$ROOT/script/e1/validate_traces.py" \
    --trace-root "$TRACE_ROOT" \
    --ledger "$LEDGER" \
    --output "$RESULT_ROOT/trace_validation.csv"
cp -- "$LEDGER" "$RESULT_ROOT/trajectory.csv"
"$PYTHON_BIN" "$ROOT/script/e1/derive_results.py" \
    --input "$RESULT_ROOT/trajectory.csv" --result-dir "$RESULT_ROOT"
"$PYTHON_BIN" "$ROOT/script/e1/plot_figure1.py" --result-dir "$RESULT_ROOT"
echo "E1 complete data: $RESULT_ROOT"
