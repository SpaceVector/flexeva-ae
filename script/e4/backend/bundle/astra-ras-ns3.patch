+struct TimedSimulationPhaseResult {
+    std::string name;
+    double wall_seconds;
+    int64_t simulated_ns;
+};
+
+void record_timed_simulation_phase(
+    const TimedSimulationPhaseResult& result) {
+    json payload = {{"phase", "simulation"},
+                    {"name", result.name},
+                    {"wall_seconds", result.wall_seconds},
+                    {"simulated_ns", result.simulated_ns},
+                    {"excludes_process_initialization", true},
+                    {"excludes_backend_initialization", true}};
+    AstraSim::RasTraceRecorder::get().record_event(
+        "context", "simulation_phase", "global", payload.dump());
+    std::cout << "ASTRA-sim RAS simulation phase[" << result.name
+              << "]: wall_seconds="
+              << std::setprecision(9) << result.wall_seconds
+              << " simulated_ns=" << result.simulated_ns << std::endl;
+}
