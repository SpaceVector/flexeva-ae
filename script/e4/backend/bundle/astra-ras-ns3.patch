+void Workload::start_ras_incremental_execution() {
+    if (!ras_incremental_active || ras_incremental_started || is_finished) {
+        return;
+    }
+    ras_incremental_started = true;
+    if (ras_incremental_nodes.empty()) {
+        complete_ras_incremental_execution();
+        return;
+    }
+    schedule_ras_incremental_ready_nodes();
+}
+
+void Workload::schedule_ras_incremental_ready_nodes() {
+    if (!ras_incremental_active || is_finished) {
+        return;
+    }
+
+    for (auto& item : ras_incremental_nodes) {
+        const uint64_t node_id = item.first;
+        RasIncrementalNodeState& state = item.second;
+        if (state.issued || state.finished || !state.pending_parents.empty()) {
+            continue;
+        }
+        if (state.boundary) {
+            schedule_ras_boundary_release(node_id);
+        } else if (state.executable) {
+            ras_incremental_ready_executable_nodes.insert(node_id);
+        }
+    }
+
+    bool issued_any = true;
+    while (issued_any) {
+        issued_any = false;
+        for (auto it = ras_incremental_ready_executable_nodes.begin();
+             it != ras_incremental_ready_executable_nodes.end();) {
+            const uint64_t node_id = *it;
+            auto state_it = ras_incremental_nodes.find(node_id);
+            if (state_it == ras_incremental_nodes.end() ||
+                state_it->second.issued || state_it->second.finished) {
+                it = ras_incremental_ready_executable_nodes.erase(it);
+                continue;
+            }
+            std::shared_ptr<ETFeederNode> node = et_feeder->lookupNode(node_id);
+            if (!hw_resource->is_available(node)) {
+                ++it;
+                continue;
+            }
+            state_it->second.issued = true;
+            it = ras_incremental_ready_executable_nodes.erase(it);
+            record_chakra_node_event(sys, "ras_incremental_ready", node);
+            issue(node);
+            issued_any = true;
+            break;
+        }
+    }
+}
+
+void Workload::schedule_ras_boundary_release(uint64_t node_id) {
+    auto state_it = ras_incremental_nodes.find(node_id);
+    if (state_it == ras_incremental_nodes.end() || state_it->second.issued ||
+        state_it->second.finished || !state_it->second.boundary) {
+        return;
+    }
+    state_it->second.issued = true;
+
+    const uint64_t finish_tick = state_it->second.timing.finish_tick;
+    const Tick target_tick = sys->simulation_epoch_start + finish_tick;
+    const Tick now = Sys::boostedTick();
+    const Tick delay = target_tick > now ? target_tick - now : 0;
+
+    if (delay == 0) {
+        finish_ras_incremental_node(node_id);
+        return;
+    }
+
+    WorkloadLayerHandlerData* wlhd = new WorkloadLayerHandlerData;
+    wlhd->node_id = node_id;
+    wlhd->ras_boundary_release = true;
+    sys->register_event(this, EventType::General, wlhd, delay);
+}
+
+void Workload::finish_ras_incremental_node(uint64_t node_id) {
+    if (!ras_incremental_active || is_finished) {
+        return;
+    }
+    auto state_it = ras_incremental_nodes.find(node_id);
+    if (state_it == ras_incremental_nodes.end() || state_it->second.finished) {
+        return;
+    }
+
+    RasIncrementalNodeState& state = state_it->second;
+    state.finished = true;
+    ras_incremental_ready_executable_nodes.erase(node_id);
+    if (ras_incremental_pending_nodes > 0) {
+        --ras_incremental_pending_nodes;
+    }
+
+    if (state.boundary) {
+        std::shared_ptr<ETFeederNode> node = et_feeder->lookupNode(node_id);
+        record_chakra_node_event(
+            sys, "chakra_node_boundary_release", node,
+            {{"cached_finish_tick", state.timing.finish_tick},
+             {"cached_issue_tick", state.timing.issue_tick},
+             {"cached_duration", state.timing.duration},
+             {"reuse_partition_id", ras_workload_node_id(sys, node_id)}});
+    }
+
+    for (const uint64_t child_id : state.children) {
+        auto child_it = ras_incremental_nodes.find(child_id);
+        if (child_it != ras_incremental_nodes.end()) {
+            child_it->second.pending_parents.erase(node_id);
+        }
+    }
+
+    if (ras_incremental_complete()) {
+        complete_ras_incremental_execution();
+        return;
+    }
+    schedule_ras_incremental_ready_nodes();
+}
+
+bool Workload::ras_incremental_complete() const {
+    return ras_incremental_active && ras_incremental_pending_nodes == 0;
+}
+
+void Workload::complete_ras_incremental_execution() {
+    if (is_finished) {
+        return;
+    }
+    record_ras_incremental_event(
+        sys, "ras_incremental_complete",
+        {{"dag_nodes", ras_incremental_nodes.size()}});
+    report();
+    sys->comm_NI->sim_notify_finished();
+    is_finished = true;
+}
