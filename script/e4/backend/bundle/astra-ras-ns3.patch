+TimedSimulationPhaseResult run_workload_phase(
+    const std::string& phase_name,
+    const std::string& phase_workload_configuration,
+    Analytical::AnalyticalRemoteMemory* mem) {
+    reset_astra_ns3_runtime_state();
+    std::vector<ASTRASimNetwork*> networks(num_npus, nullptr);
+    std::vector<AstraSim::Sys*> systems(num_npus, nullptr);
+    NS3BackendCompletionTracker completion_tracker(num_npus);
+
+    for (int npu_id = 0; npu_id < num_npus; npu_id++) {
+        networks[npu_id] = new ASTRASimNetwork(npu_id, &completion_tracker);
+        systems[npu_id] = new AstraSim::Sys(
+            npu_id, phase_workload_configuration, comm_group_configuration,
+            system_configuration, mem, networks[npu_id], logical_dims,
+            queues_per_dim, injection_scale, comm_scale, rendezvous_protocol);
+    }
+
+    const int64_t simulated_start_ns = Simulator::Now().GetNanoSeconds();
+    const auto timed_phase_start = std::chrono::steady_clock::now();
+
+    for (int i = 0; i < num_npus; i++) {
+        systems[i]->workload->fire();
+    }
+
+    if (!completion_tracker.all_ranks_finished()) {
+        Simulator::Run();
+    }
+    const auto timed_phase_end = std::chrono::steady_clock::now();
+    const int64_t simulated_end_ns = Simulator::Now().GetNanoSeconds();
+
+    for (auto* system : systems) {
+        delete system;
+    }
+    for (auto* network : networks) {
+        delete network;
+    }
+
+    return {phase_name,
+            std::chrono::duration<double>(timed_phase_end -
+                                          timed_phase_start)
+                .count(),
+            simulated_end_ns - simulated_start_ns};
+}
