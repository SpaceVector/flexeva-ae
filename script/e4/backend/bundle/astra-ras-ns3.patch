+std::string read_context_file(const std::string& path) {
+    if (path.find("empty") != std::string::npos) {
+        return "empty";
+    }
+
+    std::ifstream input(path, std::ios::in | std::ios::binary);
+    if (!input.is_open()) {
+        throw std::runtime_error("unable to open context file: " + path);
+    }
+    std::ostringstream contents;
+    contents << input.rdbuf();
+    return contents.str();
+}
+
+void append_context_field(std::ostringstream& context,
+                          const std::string& name,
+                          const std::string& value) {
+    context << name.size() << ':' << name << '=' << value.size() << ':'
+            << value << '\n';
+}
+
+std::string ns3_network_configuration_context(const std::string& path) {
+    std::istringstream lines(read_context_file(path));
+    std::ostringstream context;
+    std::string line;
+    while (std::getline(lines, line)) {
+        std::istringstream tokens(line);
+        std::string key;
+        std::string value;
+        tokens >> key >> value;
+        if (key == "TOPOLOGY_FILE" || key == "FLOW_FILE" ||
+            key == "TRACE_FILE") {
+            context << key << " ";
+            append_context_field(context, "contents",
+                                 read_context_file(value));
+        } else if (key == "TRACE_OUTPUT_FILE" || key == "FCT_OUTPUT_FILE" ||
+                   key == "PFC_OUTPUT_FILE" || key == "QLEN_MON_FILE") {
+            context << key << " <ignored-output-path>\n";
+        } else {
+            context << line << '\n';
+        }
+    }
+    return context.str();
+}
+
+std::string scalar_to_string(const double value) {
+    std::ostringstream output;
+    output << std::setprecision(17) << value;
+    return output.str();
+}
+
+uint64_t fnv1a64(const std::string& value, const uint64_t seed) {
+    uint64_t hash = 14695981039346656037ull ^ seed;
+    for (const unsigned char c : value) {
+        hash ^= c;
+        hash *= 1099511628211ull;
+    }
+    return hash;
+}
+
+std::string evaluation_context_fingerprint(
+    const std::string& backend_name,
+    const std::string& system_configuration,
+    const std::string& network_configuration,
+    const std::string& remote_memory_configuration,
+    const std::string& logical_topology_configuration,
+    const std::string& comm_group_configuration,
+    const int num_queues_per_dim,
+    const double comm_scale,
+    const double injection_scale,
+    const bool rendezvous_protocol) {
+    std::ostringstream context;
+    append_context_field(context, "backend_name", backend_name);
+    append_context_field(context, "system_configuration_contents",
+                         read_context_file(system_configuration));
+    append_context_field(context, "network_configuration_contents",
+                         ns3_network_configuration_context(
+                             network_configuration));
+    append_context_field(context, "remote_memory_configuration_contents",
+                         read_context_file(remote_memory_configuration));
+    append_context_field(context, "logical_topology_configuration_contents",
+                         read_context_file(logical_topology_configuration));
+    append_context_field(context, "comm_group_configuration_contents",
+                         read_context_file(comm_group_configuration));
+    append_context_field(context, "num_queues_per_dim",
+                         std::to_string(num_queues_per_dim));
+    append_context_field(context, "comm_scale", scalar_to_string(comm_scale));
+    append_context_field(context, "injection_scale",
+                         scalar_to_string(injection_scale));
+    append_context_field(context, "rendezvous_protocol",
+                         rendezvous_protocol ? "true" : "false");
+
+    const std::string serialized_context = context.str();
+    std::ostringstream fingerprint;
+    fingerprint << "fnv1a128:" << std::hex << std::setfill('0')
+                << std::setw(16)
+                << fnv1a64(serialized_context, 0x9ae16a3b2f90404full)
+                << std::setw(16)
+                << fnv1a64(serialized_context, 0xc3a5c85c97cb3127ull);
+    return fingerprint.str();
+}
+
+bool initialize_ras_context(const std::string& backend_name,
+                            const std::string& system_configuration,
+                            const std::string& network_configuration,
+                            const std::string& remote_memory_configuration,
+                            const std::string& logical_topology_configuration,
+                            const std::string& comm_group_configuration,
+                            const int num_queues_per_dim,
+                            const double comm_scale,
+                            const double injection_scale,
+                            const bool rendezvous_protocol) {
+    try {
+        const std::string fingerprint = evaluation_context_fingerprint(
+            backend_name, system_configuration, network_configuration,
+            remote_memory_configuration, logical_topology_configuration,
+            comm_group_configuration, num_queues_per_dim, comm_scale,
+            injection_scale, rendezvous_protocol);
+        AstraSim::RasReplayCache::set_current_context_fingerprint(fingerprint);
+        json payload = {{"context_schema", "ras-eval-context-v1"},
+                        {"context_fingerprint", fingerprint},
+                        {"backend_name", backend_name},
+                        {"num_queues_per_dim", num_queues_per_dim},
+                        {"comm_scale", comm_scale},
+                        {"injection_scale", injection_scale},
+                        {"rendezvous_protocol", rendezvous_protocol}};
+        AstraSim::RasTraceRecorder::get().record_event(
+            "context", "run_context", "global", payload.dump());
+    } catch (const std::exception& e) {
+        std::cerr << "ASTRA-sim RAS context initialization failed: "
+                  << e.what() << std::endl;
+        return false;
+    }
+    return true;
+}
+
+bool configure_ras_replay_cache(const std::string& replay_cache_path,
+                                const std::string& reuse_plan_path,
+                                const bool allow_environment = true) {
+    const bool has_replay_cache_path = !replay_cache_path.empty();
+    const bool has_reuse_plan_path = !reuse_plan_path.empty();
+    if (has_replay_cache_path != has_reuse_plan_path) {
+        std::cerr << "ASTRA-sim RAS replay requires both --ras-replay-cache "
+                  << "and --ras-reuse-plan when either is provided"
+                  << std::endl;
+        return false;
+    }
+
+    if (has_replay_cache_path) {
+        return AstraSim::RasReplayCache::get().load_from_files(
+            replay_cache_path, reuse_plan_path);
+    }
+
+    if (allow_environment) {
+        AstraSim::RasReplayCache::get().load_from_environment();
+    } else {
+        AstraSim::RasReplayCache::get().clear();
+    }
+    return true;
+}
