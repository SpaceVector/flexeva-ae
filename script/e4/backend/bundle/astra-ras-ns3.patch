+bool is_ras_partition_local_replayable_node_type(ChakraNodeType node_type) {
+    return node_type == ChakraNodeType::MEM_LOAD_NODE ||
+           node_type == ChakraNodeType::MEM_STORE_NODE ||
+           node_type == ChakraNodeType::COMP_NODE;
+}
+
+bool is_ras_comm_node_type(ChakraNodeType node_type) {
+    return node_type == ChakraNodeType::COMM_COLL_NODE ||
+           node_type == ChakraNodeType::COMM_SEND_NODE ||
+           node_type == ChakraNodeType::COMM_RECV_NODE;
+}
+
+bool lookup_ras_replay_duration(
+    const std::shared_ptr<Chakra::FeederV3::ETFeederNode>& node,
+    const std::string& partition_id,
+    const std::string& collective_group_key,
+    bool incremental_active,
+    uint64_t* duration) {
+    const ChakraNodeType node_type = node->type();
+    if (is_ras_partition_local_replayable_node_type(node_type)) {
+        if (incremental_active) {
+            RasReplayCache::WorkloadTiming timing;
+            if (!RasReplayCache::get()
+                     .incremental_workload_partition_can_reuse_duration(
+                         partition_id, collective_group_key) ||
+                !RasReplayCache::get().lookup_workload_timing(partition_id,
+                                                              &timing)) {
+                return false;
+            }
+            *duration = timing.duration;
+            return true;
+        }
+        return RasReplayCache::get().lookup_workload_duration(partition_id,
+                                                              duration);
+    }
+    if (node_type == ChakraNodeType::COMM_COLL_NODE) {
+        if (incremental_active &&
+            !RasReplayCache::get()
+                 .incremental_workload_partition_can_reuse_duration(
+                     partition_id, collective_group_key)) {
+            return false;
+        }
+        return RasReplayCache::get().lookup_collective_workload_duration(
+            partition_id, collective_group_key, duration);
+    }
+    return false;
+}
+
+bool should_suppress_incremental_refresh_issue(
+    const std::shared_ptr<Chakra::FeederV3::ETFeederNode>& node,
+    bool incremental_active,
+    bool has_cached_duration) {
+    return incremental_active && has_cached_duration &&
+           is_ras_partition_local_replayable_node_type(node->type());
+}
