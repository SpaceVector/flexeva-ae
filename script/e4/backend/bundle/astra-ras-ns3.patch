+struct HotRunConfig {
+    std::string name;
+    std::string workload_configuration;
+    std::string ras_replay_cache;
+    std::string ras_reuse_plan;
+};
+
+std::string required_json_string(const json& value,
+                                 const std::string& field,
+                                 const std::string& context) {
+    if (!value.contains(field) || !value[field].is_string() ||
+        value[field].get<std::string>().empty()) {
+        throw std::runtime_error(context + " missing non-empty string field " +
+                                 field);
+    }
+    return value[field].get<std::string>();
+}
+
+std::string optional_json_string(const json& value,
+                                 const std::string& field,
+                                 const std::string& fallback = "") {
+    if (!value.contains(field)) {
+        return fallback;
+    }
+    if (!value[field].is_string()) {
+        throw std::runtime_error("field " + field + " must be a string");
+    }
+    return value[field].get<std::string>();
+}
+
+std::vector<HotRunConfig> load_hot_run_manifest(const std::string& path) {
+    std::ifstream input(path);
+    if (!input.is_open()) {
+        throw std::runtime_error("unable to open RAS hot run manifest: " +
+                                 path);
+    }
+    json root;
+    input >> root;
+    if (!root.is_object() ||
+        root.value("schema_version", "") !=
+            "astra-sim-ns3-hot-runs-v1" ||
+        !root.contains("runs") || !root["runs"].is_array()) {
+        throw std::runtime_error(
+            "RAS hot run manifest must use schema "
+            "astra-sim-ns3-hot-runs-v1 and contain a runs array");
+    }
+    std::vector<HotRunConfig> runs;
+    int index = 0;
+    for (const auto& run : root["runs"]) {
+        if (!run.is_object()) {
+            throw std::runtime_error("RAS hot run entry must be an object");
+        }
+        const std::string context =
+            "RAS hot run entry " + std::to_string(index);
+        HotRunConfig config;
+        config.name = optional_json_string(
+            run, "name", "run" + std::to_string(index));
+        config.workload_configuration = required_json_string(
+            run, "workload_configuration", context);
+        config.ras_replay_cache = optional_json_string(
+            run, "ras_replay_cache",
+            optional_json_string(run, "replay_cache"));
+        config.ras_reuse_plan = optional_json_string(
+            run, "ras_reuse_plan",
+            optional_json_string(run, "reuse_plan"));
+        runs.push_back(config);
+        index++;
+    }
+    if (runs.empty()) {
+        throw std::runtime_error("RAS hot run manifest has no runs");
+    }
+    return runs;
+}
