+void Workload::initialize_ras_incremental_scheduler() {
+    RasReplayCache& replay_cache = RasReplayCache::get();
+    if (!replay_cache.incremental_execution_enabled()) {
+        return;
+    }
+
+    ras_incremental_active = true;
+    const auto executable_node_ids =
+        replay_cache.executable_workload_node_ids_for_rank(sys->id);
+    std::queue<uint64_t> executable_worklist;
+    std::unordered_set<uint64_t> queued_executable_nodes;
+
+    for (const uint64_t node_id : executable_node_ids) {
+        auto& state = ras_incremental_nodes[node_id];
+        state.executable = true;
+        state.boundary = false;
+        if (queued_executable_nodes.insert(node_id).second) {
+            executable_worklist.push(node_id);
+        }
+    }
+
+    while (!executable_worklist.empty()) {
+        const uint64_t node_id = executable_worklist.front();
+        executable_worklist.pop();
+        std::shared_ptr<ETFeederNode> node = et_feeder->lookupNode(node_id);
+
+        std::unordered_set<uint64_t> deps;
+        for (const NodeId dep_id : node->data_deps()) {
+            deps.insert(dep_id);
+        }
+        for (const NodeId dep_id : node->ctrl_deps()) {
+            deps.insert(dep_id);
+        }
+
+        for (const uint64_t dep_id : deps) {
+            const std::string dep_partition_id =
+                ras_workload_node_id(sys, dep_id);
+            auto& child_state = ras_incremental_nodes[node_id];
+            child_state.pending_parents.insert(dep_id);
+            ras_incremental_nodes[dep_id].children.insert(node_id);
+
+            if (executable_node_ids.find(dep_id) != executable_node_ids.end()) {
+                auto& dep_state = ras_incremental_nodes[dep_id];
+                dep_state.executable = true;
+                dep_state.boundary = false;
+                if (queued_executable_nodes.insert(dep_id).second) {
+                    executable_worklist.push(dep_id);
+                }
+                continue;
+            }
+
+            RasReplayCache::WorkloadTiming timing;
+            if (!replay_cache.workload_partition_is_reusable(
+                    dep_partition_id) ||
+                !replay_cache.lookup_workload_timing(dep_partition_id,
+                                                     &timing)) {
+                throw std::runtime_error(
+                    "RAS incremental execution dependency " +
+                    dep_partition_id +
+                    " is neither executable nor a reusable cached boundary");
+            }
+            auto& dep_state = ras_incremental_nodes[dep_id];
+            if (dep_state.executable) {
+                continue;
+            }
+            dep_state.boundary = true;
+            dep_state.timing = timing;
+        }
+    }
+
+    ras_incremental_pending_nodes = ras_incremental_nodes.size();
+    record_ras_incremental_event(
+        sys, "ras_incremental_init",
+        {{"executable_nodes", executable_node_ids.size()},
+         {"dag_nodes", ras_incremental_nodes.size()}});
+}
