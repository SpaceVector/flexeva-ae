+    uint64_t duration) {
+    if (node->is_cpu_op()) {
+        hw_resource->tics_cpu_ops += duration;
+    } else if (node->type() == ChakraNodeType::COMP_NODE) {
+        hw_resource->tics_gpu_ops += duration;
+    } else {
+        hw_resource->tics_gpu_comms += duration;
+    }
