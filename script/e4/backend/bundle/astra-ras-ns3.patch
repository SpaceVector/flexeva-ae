+std::string ras_rank_lane(const Sys* sys) {
+    return "rank:" + std::to_string(sys->id);
+}
+
+std::string ras_workload_node_id(const Sys* sys, const uint64_t node_id) {
+    return ras_rank_lane(sys) + "/chakra:" + std::to_string(node_id);
+}
+
+std::vector<std::string> ras_workload_node_ids(
+    const Sys* sys,
+    const std::vector<NodeId>& node_ids) {
+    std::vector<std::string> event_ids;
+    event_ids.reserve(node_ids.size());
+    for (const NodeId node_id : node_ids) {
+        event_ids.push_back(ras_workload_node_id(sys, node_id));
+    }
+    return event_ids;
+}
+
+std::string ras_dataset_id(const Sys* sys, const int dataset_id) {
+    return ras_rank_lane(sys) + "/dataset:" + std::to_string(dataset_id);
+}
+
+std::vector<bool> collective_involved_dims(
+    const std::shared_ptr<Chakra::FeederV3::ETFeederNode>& node) {
+    std::vector<bool> involved_dims;
+    if (node->has_attr("involved_dim")) {
+        const ChakraProtoMsg::AttributeProto& attr =
+            node->get_attr_msg("involved_dim");
+
+        if (attr.has_bool_list()) {
+            const ChakraProtoMsg::BoolList& bool_list = attr.bool_list();
+            for (int i = 0; i < bool_list.values_size(); ++i) {
+                involved_dims.push_back(bool_list.values(i));
+            }
+        } else {
+            cerr << "Expected bool_list in involved_dim but found another type."
+                 << endl;
+            exit(EXIT_FAILURE);
+        }
+    } else {
+        for (int i = 0; i < 4; i++) {
+            involved_dims.push_back(true);
+        }
+    }
+    return involved_dims;
+}
+
+CommunicatorGroup* resolve_comm_group_for_ras(
+    Workload* workload,
+    const std::shared_ptr<Chakra::FeederV3::ETFeederNode>& node) {
+    std::string comm_group_name = node->pg_name<std::string>("");
+    if (comm_group_name == "" || comm_group_name == "0") {
+        return nullptr;
+    }
+
+    const int comm_group_id = std::stoi(comm_group_name);
+    if (workload->comm_groups.find(comm_group_id) ==
+        workload->comm_groups.end()) {
+        LoggerFactory::get_logger("workload")
+            ->critical(
+                "For rank {} ET node {}, communicator group {} not found",
+                workload->sys->id, node->id(), comm_group_id);
+        exit(EXIT_FAILURE);
+    }
+    return workload->comm_groups[comm_group_id];
+}
+
+std::vector<int> collective_group_ranks(const Sys* sys,
+                                        CommunicatorGroup* comm_group) {
+    if (comm_group != nullptr) {
+        return comm_group->involved_NPUs;
+    }
+
+    std::vector<int> ranks;
+    ranks.reserve(sys->total_nodes);
+    for (int i = 0; i < sys->total_nodes; ++i) {
+        ranks.push_back(i);
+    }
+    return ranks;
+}
+
+json collective_group_payload(
+    Workload* workload,
+    const std::shared_ptr<Chakra::FeederV3::ETFeederNode>& node) {
+    CommunicatorGroup* comm_group = resolve_comm_group_for_ras(workload, node);
+    const std::vector<bool> involved_dims = collective_involved_dims(node);
+    const std::vector<int> group_ranks =
+        collective_group_ranks(workload->sys, comm_group);
+    const std::string pg_name = node->pg_name<std::string>("");
+    const uint64_t comm_type = node->comm_type<uint64_t>();
+    const uint64_t comm_size = node->comm_size<uint64_t>();
+    const uint32_t comm_priority = node->comm_priority<uint32_t>();
+
+    json key = {{"node_id", node->id()},
+                {"comm_type", comm_type},
+                {"comm_size", comm_size},
+                {"comm_priority", comm_priority},
+                {"pg_name", pg_name},
+                {"involved_dim", involved_dims},
+                {"group_ranks", group_ranks}};
+
+    return {{"collective_group_key", key.dump()},
+            {"collective_node_id", node->id()},
+            {"collective_comm_type", comm_type},
+            {"collective_comm_size", comm_size},
+            {"collective_comm_priority", comm_priority},
+            {"collective_pg_name", pg_name},
+            {"collective_involved_dim", involved_dims},
+            {"collective_group_ranks", group_ranks}};
+}
