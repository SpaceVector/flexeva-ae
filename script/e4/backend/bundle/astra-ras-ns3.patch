+template <typename T>
+void add_node_attr_if_present(
+    json& payload,
+    const std::shared_ptr<Chakra::FeederV3::ETFeederNode>& node,
+    const char* attr_name) {
+    if (node->has_attr(attr_name)) {
+        payload[attr_name] = node->get_attr<T>(attr_name);
+    }
+}
+
+void record_chakra_node_event(
+    Sys* sys,
+    const char* kind,
+    const std::shared_ptr<Chakra::FeederV3::ETFeederNode>& node,
+    json payload = json::object()) {
+    if (!RasTraceRecorder::get().enabled()) {
+        return;
+    }
+
+    payload["tick"] = Sys::boostedTick();
+    payload["rank"] = sys->id;
+    payload["node_id"] = node->id();
+    payload["node_name"] = node->name();
+    payload["node_type"] = static_cast<uint64_t>(node->type());
+    payload["event_id"] = ras_workload_node_id(sys, node->id());
+    payload["runtime_micros"] = node->runtime();
+    const std::vector<NodeId> data_deps = node->data_deps();
+    if (!data_deps.empty()) {
+        payload["data_deps"] = data_deps;
+        payload["data_dep_event_ids"] = ras_workload_node_ids(sys, data_deps);
+    }
+    const std::vector<NodeId> ctrl_deps = node->ctrl_deps();
+    if (!ctrl_deps.empty()) {
+        payload["ctrl_deps"] = ctrl_deps;
+        payload["ctrl_dep_event_ids"] = ras_workload_node_ids(sys, ctrl_deps);
+    }
+    add_node_attr_if_present<bool>(payload, node, "is_cpu_op");
+    add_node_attr_if_present<uint64_t>(payload, node, "num_ops");
+    add_node_attr_if_present<uint64_t>(payload, node, "tensor_size");
+
+    const auto node_type = node->type();
+    if (node_type == ChakraNodeType::COMM_COLL_NODE ||
+        node_type == ChakraNodeType::COMM_SEND_NODE ||
+        node_type == ChakraNodeType::COMM_RECV_NODE) {
+        add_node_attr_if_present<uint64_t>(payload, node, "comm_type");
+        add_node_attr_if_present<uint64_t>(payload, node, "comm_size");
+        add_node_attr_if_present<uint32_t>(payload, node, "comm_src");
+        add_node_attr_if_present<uint32_t>(payload, node, "comm_dst");
+        add_node_attr_if_present<uint32_t>(payload, node, "comm_tag");
+    }
+    RasTraceRecorder::get().record_event("workload", kind, ras_rank_lane(sys),
+                                         payload.dump());
+}
+
