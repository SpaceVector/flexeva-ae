{
  "dataset_dir": "gemm_benchmark/data/runtime_provider/nccl_allreduce",
  "feature_columns": [
    "numel",
    "world_size",
    "dtype_code",
    "elem_bytes",
    "message_bytes",
    "cluster_aggregate_bytes",
    "effective_comm_bytes",
    "collective_factor",
    "log_numel",
    "log_message_bytes",
    "log_effective_comm_bytes",
    "log_world_size"
  ],
  "feature_names_path": "feature_names.txt",
  "metrics_path": "train_metrics.json",
  "model_path": "model.json",
  "operator_name": "nccl_allreduce",
  "target_column": "time_ms",
  "xgboost_params": {
    "colsample_bytree": 0.8,
    "learning_rate": 0.05,
    "max_depth": 8,
    "min_child_weight": 3.0,
    "n_estimators": 400,
    "n_jobs": -1,
    "objective": "reg:squarederror",
    "random_state": 42,
    "reg_alpha": 0.1,
    "reg_lambda": 1.0,
    "subsample": 0.8
  }
}